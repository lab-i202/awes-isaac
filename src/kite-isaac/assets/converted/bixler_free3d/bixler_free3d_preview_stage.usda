            double3 xformOp:translate = (1, 0, 0.04)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def Cube "Y_Positive_Green" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Materials/AxisGreen_Y>
            double size = 1
